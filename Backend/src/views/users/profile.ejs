<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head', {title: 'Perfil'}) %>
<body>
    <%- include('../partials/header') %>


    <body>
        <div class="container">
            <div class="dashboard">
                <div class="profile-info">
                    <h2>Información del Perfil</h2>
