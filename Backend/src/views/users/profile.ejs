                        <li><a href="/direcciones">Gestionar Direcciones</a></li>
                        <li><a href="/configuracion">Configuración de Cuenta</a></li>
                        </ul>
                </div>
            </div>
        </div>
    <%- include('../partials/footer') %>
</body>
</html>